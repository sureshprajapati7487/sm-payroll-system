# Server Environment Variables
# Copy this to .env for local development:
#   cp server/.env.example server/.env
# In production (Render), set these via Dashboard > Environment Variables

PORT=3000
NODE_ENV=development

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# REQUIRED in production — server exits on startup if missing.
# Generate strong secrets (run both commands, use separate values):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# In development: if missing, an ephemeral random secret is generated each restart
# (tokens won't survive server restarts — set these in .env for stable dev sessions).
JWT_SECRET=
JWT_EXPIRES=15m
REFRESH_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Primary frontend origin. REQUIRED in production.
FRONTEND_URL=http://localhost:5173
# Additional allowed origins (comma-separated, e.g. https://admin.example.com,https://app.example.com)
ALLOWED_ORIGINS=
# Set to "true" to allow LAN IP addresses in development (mobile testing on same WiFi)
CORS_ALLOW_LAN=false

# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank to use SQLite locally. Set to postgres:// URL for production.
DATABASE_URL=

# ── Email / SMTP (used for payslip delivery, notifications) ────────────────────
# Leave all blank to disable email — server will log instead of sending.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourcompany.com

# ── WhatsApp Business API (optional) ───────────────────────────────────────────
WHATSAPP_API=
WHATSAPP_API_URL=

# ── AWS S3 / Cloudflare R2 (for expense receipts and uploads — optional) ────────
# Files are stored with PRIVATE ACL. Use GET /api/upload/signed-url?key=... to download.
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=sm-payroll-receipts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2 or custom S3-compatible endpoints:
AWS_ENDPOINT=
