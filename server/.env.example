# Server Environment Variables
# Copy this to .env for local development:
#   cp server/.env.example server/.env
# In production (Render), set these via Dashboard > Environment Variables

PORT=3000
NODE_ENV=development

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# ⚠️  IMPORTANT: In production, replace these with RANDOM 64-char strings!
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Server will CRASH on startup if these are missing in production.
JWT_SECRET=sm-payroll-super-secret-jwt-key-2026
JWT_EXPIRES=15m
REFRESH_SECRET=sm-payroll-refresh-secret-key-2026-v2

# ── Frontend URL (used in CORS whitelist) ──────────────────────────────────────
# Production: set to your Vercel URL e.g. https://sm-payroll.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank to use SQLite locally. Set to postgres:// URL for production.
DATABASE_URL=

# ── Email / SMTP (used for payslip delivery, notifications) ────────────────────
# Leave all blank to disable email — server will log instead of sending.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourcompany.com

# ── WhatsApp Business API (optional) ───────────────────────────────────────────
WHATSAPP_API=
WHATSAPP_API_URL=

# ── AWS S3 (for employee document uploads — optional) ──────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
